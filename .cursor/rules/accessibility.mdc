# Accessibility Standards

## WCAG Compliance

Target: **WCAG 2.1 Level AA** compliance

## Semantic HTML

### Use Proper HTML Elements

```tsx
// ✅ Good - semantic HTML
<nav>
  <ul>
    <li><a href="/flights">Flights</a></li>
  </ul>
</nav>

<main>
  <article>
    <h1>Flight Search</h1>
    <section>Content</section>
  </article>
</main>

<footer>
  <p>© 2025 Company</p>
</footer>

// ❌ Bad - divs for everything
<div className="nav">
  <div className="link">Flights</div>
</div>
```

### Headings Hierarchy

```tsx
// ✅ Good - proper heading order
<h1>Flight Search</h1>
  <h2>Search Form</h2>
    <h3>Origin and Destination</h3>
  <h2>Results</h2>
    <h3>Available Flights</h3>

// ❌ Bad - skipping levels
<h1>Title</h1>
<h3>Subtitle</h3> // Should be h2
```

## ARIA Attributes

### Labels and Descriptions

```tsx
// Button with aria-label
<button aria-label="Close dialog">
  <XIcon />
</button>

// Input with aria-describedby
<input
  id="email"
  aria-describedby="email-error"
  aria-invalid={hasError}
/>
{hasError && (
  <span id="email-error" role="alert">
    Invalid email address
  </span>
)}

// Complex widget
<div
  role="combobox"
  aria-expanded={isOpen}
  aria-haspopup="listbox"
  aria-owns="city-list"
  aria-controls="city-list"
>
  <input
    role="searchbox"
    aria-autocomplete="list"
    aria-activedescendant={activeOption}
  />
  <ul id="city-list" role="listbox">
    {options.map(option => (
      <li key={option.id} role="option" aria-selected={option.selected}>
        {option.label}
      </li>
    ))}
  </ul>
</div>
```

### Live Regions

```tsx
// Announce dynamic content
<div aria-live="polite" aria-atomic="true">
  {flightCount} flights found
</div>

// For urgent messages
<div aria-live="assertive" role="alert">
  Error: Unable to process request
</div>

// Loading states
<div aria-live="polite" aria-busy={isLoading}>
  {isLoading ? "Loading flights..." : `${flights.length} flights loaded`}
</div>
```

### Hidden Content

```tsx
// Visually hidden but available to screen readers
<span className="sr-only">
  Current page
</span>

// Hide from everyone including screen readers
<div aria-hidden="true">
  Decorative content
</div>

// Hide visually but keep accessible
<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
```

## Keyboard Navigation

### Tab Order

```tsx
// Ensure logical tab order
<form>
  <input tabIndex={0} /> {/* Default, follows DOM order */}
  <button tabIndex={0}>Submit</button>
  <div tabIndex={-1}>Not in tab order</div> {/* Can be focused programmatically */}
  {/* Never use tabIndex > 0 */}
</form>
```

### Keyboard Handlers

```tsx
function AccessibleButton({ onClick, children }: Props) {
  const handleKeyDown = (e: React.KeyboardEvent) => {
    // Activate on Enter or Space
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault()
      onClick()
    }
  }
  
  return (
    <button
      onClick={onClick}
      onKeyDown={handleKeyDown}
      type="button"
    >
      {children}
    </button>
  )
}

// Arrow key navigation for custom select
function CustomSelect() {
  const handleKeyDown = (e: React.KeyboardEvent) => {
    switch (e.key) {
      case "ArrowDown":
        e.preventDefault()
        moveToNext()
        break
      case "ArrowUp":
        e.preventDefault()
        moveToPrevious()
        break
      case "Enter":
        e.preventDefault()
        selectCurrent()
        break
      case "Escape":
        e.preventDefault()
        close()
        break
    }
  }
  
  return <div onKeyDown={handleKeyDown}>...</div>
}
```

### Focus Management

```tsx
import { useRef, useEffect } from "react"

function Modal({ isOpen, onClose }: Props) {
  const modalRef = useRef<HTMLDivElement>(null)
  const previousFocusRef = useRef<HTMLElement | null>(null)
  
  useEffect(() => {
    if (isOpen) {
      // Save current focus
      previousFocusRef.current = document.activeElement as HTMLElement
      
      // Focus modal
      modalRef.current?.focus()
      
      // Trap focus within modal
      const handleTab = (e: KeyboardEvent) => {
        if (e.key === "Tab") {
          const focusableElements = modalRef.current?.querySelectorAll(
            'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
          )
          const firstElement = focusableElements?.[0] as HTMLElement
          const lastElement = focusableElements?.[focusableElements.length - 1] as HTMLElement
          
          if (e.shiftKey && document.activeElement === firstElement) {
            e.preventDefault()
            lastElement?.focus()
          } else if (!e.shiftKey && document.activeElement === lastElement) {
            e.preventDefault()
            firstElement?.focus()
          }
        }
      }
      
      document.addEventListener("keydown", handleTab)
      return () => document.removeEventListener("keydown", handleTab)
    } else {
      // Restore focus
      previousFocusRef.current?.focus()
    }
  }, [isOpen])
  
  return (
    <div
      ref={modalRef}
      role="dialog"
      aria-modal="true"
      tabIndex={-1}
    >
      {/* Modal content */}
    </div>
  )
}
```

### Skip Links

```tsx
// app/layout.tsx
export default function RootLayout({ children }: Props) {
  return (
    <html>
      <body>
        <a href="#main-content" className="skip-link">
          Skip to main content
        </a>
        <Header />
        <main id="main-content" tabIndex={-1}>
          {children}
        </main>
        <Footer />
      </body>
    </html>
  )
}

// styles
.skip-link {
  position: absolute;
  top: -40px;
  left: 0;
  background: #000;
  color: #fff;
  padding: 8px;
  z-index: 100;
}

.skip-link:focus {
  top: 0;
}
```

## Forms Accessibility

### Labels

```tsx
// ✅ Good - explicit label
<label htmlFor="email">Email</label>
<input id="email" type="email" />

// ✅ Good - wrapped label
<label>
  Email
  <input type="email" />
</label>

// ✅ Good - aria-label for icon buttons
<button aria-label="Search">
  <SearchIcon />
</button>

// ❌ Bad - no label
<input type="email" placeholder="Email" />
```

### Required Fields

```tsx
<label htmlFor="email">
  Email
  <span aria-label="required">*</span>
</label>
<input
  id="email"
  type="email"
  required
  aria-required="true"
/>

// Or use aria-label
<input
  id="email"
  type="email"
  aria-label="Email (required)"
  required
/>
```

### Error Messages

```tsx
function FormField({ error }: Props) {
  const errorId = "email-error"
  
  return (
    <div>
      <label htmlFor="email">Email</label>
      <input
        id="email"
        type="email"
        aria-invalid={!!error}
        aria-describedby={error ? errorId : undefined}
      />
      {error && (
        <span id={errorId} role="alert" className="error">
          {error}
        </span>
      )}
    </div>
  )
}
```

### Fieldsets and Legends

```tsx
<fieldset>
  <legend>Passenger Information</legend>
  
  <label htmlFor="adult-count">Adults</label>
  <input id="adult-count" type="number" min="1" />
  
  <label htmlFor="child-count">Children</label>
  <input id="child-count" type="number" min="0" />
</fieldset>
```

## Color and Contrast

### Contrast Ratios

- **Normal text**: 4.5:1 minimum
- **Large text** (18pt+ or 14pt+ bold): 3:1 minimum
- **UI components and graphics**: 3:1 minimum

```tsx
// ✅ Good - sufficient contrast
<button className="bg-primary-500 text-white">
  Submit
</button>

// ❌ Bad - insufficient contrast
<button className="bg-gray-200 text-gray-300">
  Submit
</button>
```

### Don't Rely on Color Alone

```tsx
// ✅ Good - uses color + icon + text
<div className="text-red-500">
  <ErrorIcon />
  <span>Error: Invalid input</span>
</div>

// ❌ Bad - color only
<div className="text-red-500">
  Invalid input
</div>
```

## Images and Media

### Alt Text

```tsx
// Informative images
<Image
  src="/airline-logo.png"
  alt="Emirates Airlines logo"
  width={100}
  height={50}
/>

// Decorative images
<Image
  src="/decoration.png"
  alt="" // Empty alt for decorative images
  width={100}
  height={50}
  aria-hidden="true"
/>

// Complex images
<figure>
  <Image
    src="/chart.png"
    alt="Price trend chart showing decrease from July to August"
    width={400}
    height={300}
  />
  <figcaption>
    Detailed description: Flight prices decreased 20% between July and August
  </figcaption>
</figure>
```

