## RTL (Right-to-Left) Support

```tsx
// Set document direction
<html dir="rtl" lang="fa">

// Component with RTL support
function FlightCard() {
  return (
    <div dir="rtl" className="text-right">
      {/* Use logical properties */}
      <div className="ps-4 me-2">
        {/* ps = padding-inline-start (right in RTL) */}
        {/* me = margin-inline-end (left in RTL) */}
      </div>
    </div>
  )
}

// Icons that should flip in RTL
<ArrowIcon className="rtl:scale-x-[-1]" />
```

## Screen Reader Testing

### Announce Loading States

```tsx
function FlightSearch() {
  const [isLoading, setIsLoading] = useState(false)
  const [results, setResults] = useState([])
  
  return (
    <>
      <div
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        {isLoading && "Searching for flights..."}
        {!isLoading && results.length > 0 && `Found ${results.length} flights`}
        {!isLoading && results.length === 0 && "No flights found"}
      </div>
      
      <div aria-busy={isLoading}>
        {results.map(result => <FlightCard key={result.id} {...result} />)}
      </div>
    </>
  )
}
```

### Accessible Names

```tsx
// Ensure all interactive elements have accessible names

// Button with text
<button>Submit</button>

// Button with icon
<button aria-label="Close">
  <XIcon aria-hidden="true" />
</button>

// Link with icon
<a href="/help" aria-label="Help and support">
  <HelpIcon aria-hidden="true" />
</a>
```

## Testing Accessibility

### Automated Tools

```bash
# Install axe-core for testing
pnpm add -D @axe-core/react
```

```tsx
// jest.setup.js
import { configureAxe } from "jest-axe"

global.axe = configureAxe({
  rules: {
    // Customize rules
  }
})

// Component.test.tsx
import { axe } from "jest-axe"

it("should have no accessibility violations", async () => {
  const { container } = render(<Component />)
  const results = await axe(container)
  expect(results).toHaveNoViolations()
})
```

### Manual Testing

1. **Keyboard only navigation**:
   - Tab through all interactive elements
   - Use Enter/Space to activate
   - Use arrow keys where appropriate
   - Escape to close modals/menus

2. **Screen reader testing**:
   - NVDA (Windows) - Free
   - JAWS (Windows) - Commercial
   - VoiceOver (macOS/iOS) - Built-in
   - TalkBack (Android) - Built-in

3. **Zoom to 200%**:
   - Ensure content remains usable
   - No horizontal scrolling
   - Text doesn't overlap

4. **Color blindness simulation**:
   - Use browser extensions
   - Check contrast

## Common Patterns

### Accessible Modal

```tsx
import { Dialog } from "@radix-ui/react-dialog"

function AccessibleModal({ isOpen, onClose, children }: Props) {
  return (
    <Dialog open={isOpen} onOpenChange={onClose}>
      <Dialog.Portal>
        <Dialog.Overlay className="fixed inset-0 bg-black/50" />
        <Dialog.Content
          className="fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2"
          aria-describedby="modal-description"
        >
          <Dialog.Title>Modal Title</Dialog.Title>
          <Dialog.Description id="modal-description">
            Modal description
          </Dialog.Description>
          {children}
          <Dialog.Close aria-label="Close">
            <XIcon />
          </Dialog.Close>
        </Dialog.Content>
      </Dialog.Portal>
    </Dialog>
  )
}
```

### Accessible Dropdown

Reference Radix UI components which are accessible by default.

### Accessible Tabs

```tsx
<div role="tablist" aria-label="Flight information">
  <button
    role="tab"
    aria-selected={activeTab === "details"}
    aria-controls="details-panel"
    id="details-tab"
    onClick={() => setActiveTab("details")}
  >
    Details
  </button>
  
  <div
    role="tabpanel"
    id="details-panel"
    aria-labelledby="details-tab"
    hidden={activeTab !== "details"}
  >
    Details content
  </div>
</div>
```

